 @inbook{Szepesvári_2011,
  edition      = {1},
  title        = {Reinforcement Learning Algorithms for {MDPs}},
  isbn         = {978-0-470-40063-0},
  url          = {https://onlinelibrary.wiley.com/doi/10.1002/9780470400531.eorms0714},
